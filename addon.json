{
  "id": "gateway-paypal",
  "name": "PayPal",
  "version": "0.1.0",
  "kind": "gateway",
  "engine": "wasm",
  "provides": "paypal",
  "abi": "0.2.0",
  "wasm": "addon.wasm",
  "description": "addons.desc.gateway.paypal",
  "author": "MythicalSystems",
  "permissions": [
    "payments.process",
    "network.outbound"
  ],
  "capabilities": {
    "http": [
      "api-m.paypal.com",
      "api-m.sandbox.paypal.com",
      "$setting:api_base"
    ],
    "secrets": [
      "client_id",
      "client_secret",
      "webhook_id",
      "webhook_public_key"
    ]
  },
  "settings": []
}
